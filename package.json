{
  "name": "sveltekit-prismic-starter-blux",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --host",
    "vite:dev": "vite dev --host",
    "verify": "pnpm lint && pnpm check && pnpm build && pnpm test",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "prepare": "simple-git-hooks",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:smoke": "playwright install chromium && playwright test --grep @smoke",
    "test:nightly": "playwright test tests/interaction/reveal-no-js.spec.ts tests/interaction/modal-scroll-lock.spec.ts",
    "test:scaffold": "playwright test --grep-invert @smoke",
    "test:e2e": "playwright test",
    "prismic:gen": "prismic gen types && prismic gen slice-index"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.3.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.18.0",
    "globals": "^17.6.0",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "prismic": "^1.22.0",
    "sharp": "^0.35.0",
    "simple-git-hooks": "^2.14.0",
    "svelte": "^5.55.10",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@prismicio/client": "^7.21.8",
    "@prismicio/svelte": "^2.2.1",
    "@reddoorla/maintenance": "^0.97.0",
    "@tailwindcss/vite": "^4.3.0",
    "@zerodevx/svelte-img": "^2.1.2",
    "svelte-gestures": "^5.2.2"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -x node_modules/.bin/lint-staged ]; then node_modules/.bin/lint-staged; else echo \"pre-commit: node_modules is not installed in this checkout, so prettier did not run\"; fi"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
